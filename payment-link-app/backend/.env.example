PORT=5001
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/payment_link_db

# Razorpay Credentials (Get from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Meta WhatsApp Cloud API Credentials (Get from Meta for Developers Portal)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=EAAG...YourMetaAccessTokenHere
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=payment_link_notification

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
